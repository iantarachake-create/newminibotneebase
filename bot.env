# ===== POPKID-MD MINI BOT SETTINGS =====
# Ready to deploy: upload the project to a PRIVATE GitHub repo.
# This file contains secrets (database password, encryption key). Never put it in a public repo.
# DATABASE_URL below is the Supabase "Session pooler" string (works from Render; the direct
# db.<ref>.supabase.co host is IPv6-only).

DATABASE_URL=postgresql://postgres.gcyxcpejhwdnnlazqwcg:taracha2004%3F@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Tables are created with this prefix, so this bot can share the SAME Supabase project as your other bot
# without their data mixing. Do not change it after users have linked.
DB_TABLE_PREFIX=nee_

# Encrypts stored WhatsApp credentials in the database. Do NOT change it after users have linked,
# or their sessions become unreadable. Keep a copy somewhere safe. (Different from your other bot's key.)
ENCRYPTION_KEY=bc9f2c61608d4d55a136b9422fefc1a6f2cc9afc58a1b70f65ce0bc8bdc2814e

DB_POOL_MAX=5
MAX_SESSIONS=50
RESTORE_STAGGER_MS=2500
RESTORE_BATCH=5

# ---- Defaults for every newly linked account (same as the original NEEBASE config.js) ----
# Each user can change these for their own account with the bot's commands.
PREFIX=.
NON_PREFIX=true
AUTO_READ_STATUS=true
AUTO_REACT_STATUS=true
AUTO_BIO=true
ALWAYS_ONLINE=true
AUTO_TYPING=true
AUTO_RECORDING=false
AUTO_REACT=false
ANTICALL=false
ANTIDELETE=indm
MODE=public
OWNER_NAME=Popkid Kenya

# WhatsApp channel every linked account follows once. Leave empty to disable.
FOLLOW_CHANNELS=120363426692424154@newsletter

# Optional: channel shown on every reply's forwarded-style header. Leave unset to keep the original one.
# NEWSLETTER_JID=120363426692424154@newsletter
